        "import os\n",
        "import requests\n",
        "from gtts import gTTS\n",
        "from IPython.display import Audio, display\n",
        "\n",
        "API_KEY = \"ebe1ec52058b363e7f0cc2d8a482d168\"\n",
        "def speak_weather(location: str):\n",
        "\n",
        "    geo = requests.get(f\"https://api.openweathermap.org/geo/1.0/direct?q={location}&appid={API_KEY}\").json()\n",
        "    if not geo:\n",
        "        return print(f\"Location '{location}' not found.\")\n",
        "\n",
        "\n",
        "    w = requests.get(f\"https://api.openweathermap.org/data/2.5/weather?lat={geo[0]['lat']}&lon={geo[0]['lon']}&appid={API_KEY}&units=metric\").json()\n",
        "\n",
        "    text = f\"Weather update for {geo[0]['name']}. {w['weather'][0]['description']} with a temperature of {w['main']['temp']} degrees Celsius and {w['main']['humidity']} percent humidity.\"\n",
        "    print(f\"\\n[Announcing]: {text}\")\n",
        "    gTTS(text=text, lang='en').save(\"temp.mp3\")\n",
        "    display(Audio(\"temp.mp3\", autoplay=True))\n",
        "loc = input(\"Enter location: \").strip()\n",
        "if loc:\n",
        "    speak_weather(loc)"
